# Copy to config/local.env for machine-specific settings.
# config/local.env is ignored by git.

# Converter executable. Default is dcm2niix if available on PATH.
CONVERTER_BIN=dcm2niix

# dcm2niix filename pattern. Example placeholders:
# %p protocol, %s series, %t time, %e echo, %f folder
DICOM_FILENAME_PATTERN=%p_%s

# Compression: y / n / i (internal)
DICOM_GZIP=y

# Whether existing files may be replaced by the converter: y / n
DICOM_OVERWRITE=n

# Optional extra flags passed verbatim to the converter.
# Keep empty unless required locally.
DICOM_EXTRA_ARGS=
